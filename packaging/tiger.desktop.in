[Desktop Entry]
Type=Application
Name=Tiger Browser
GenericName=Web Browser
Comment=Privacy-hardened, Omarchy-native Firefox profile
Exec=@EXEC@ %u
Icon=tiger
Terminal=false
Categories=Network;WebBrowser;
