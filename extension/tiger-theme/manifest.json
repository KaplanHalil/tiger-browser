{
  "manifest_version": 2,
  "name": "Tiger Theme",
  "version": "0.1.0",
  "description": "Live Omarchy theme switcher for Tiger.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiger-theme@tiger-browser.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["nativeMessaging", "theme"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Tiger Theme (Alt+Shift+Y)",
    "default_area": "navbar",
    "default_popup": "popup.html",
    "browser_style": false,
    "default_icon": {
      "16": "icons/theme-16.png",
      "32": "icons/theme-32.png",
      "48": "icons/theme-48.png",
      "96": "icons/theme-96.png",
      "128": "icons/theme-128.png"
    }
  },
  "commands": {
    "open-theme": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Open the Tiger theme switcher"
    }
  },
  "icons": {
    "16": "icons/mark-16.png",
    "32": "icons/mark-32.png",
    "48": "icons/mark-48.png",
    "96": "icons/mark-96.png",
    "128": "icons/mark-128.png"
  }
}
